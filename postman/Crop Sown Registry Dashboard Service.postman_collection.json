  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Contract checks for every request. Keys per chart mirror CONTRACT in the service's tests/test_charts.py.",
          "const CONTRACT = {\"cropKpis\": [\"avg_plot_size\", \"crop_types\", \"farmers\", \"owned_area\", \"registrations\", \"total_area\", \"woredas_reporting\"], \"cropAreaByCrop\": [\"area\", \"crop\", \"crop_code\", \"farmers\"], \"cropAreaByRegion\": [\"farmer_count\", \"farmers\", \"region\", \"region_code\"], \"cropAreaByZone\": [\"farmer_count\", \"farmers\", \"zone\", \"zone_code\"], \"cropAreaByWoreda\": [\"farmer_count\", \"farmers\", \"woreda\", \"woreda_code\"], \"cropAreaByKebele\": [\"farmer_count\", \"farmers\", \"kebele\", \"kebele_code\"], \"cropTopWoredas\": [\"area\", \"farmers\", \"woreda\", \"woreda_code\"], \"cropLandTenureSplit\": [\"area\", \"ownership_type\", \"ownership_type_code\", \"parcels\"], \"cropBySeason\": [\"area\", \"farmers\", \"season\", \"season_code\"], \"cropTrendByMonth\": [\"farmers\", \"owned_area\", \"period\", \"total_area\"], \"cropByStatus\": [\"registrations\", \"status\"], \"cropByLifecycleStage\": [\"lifecycle_stage\", \"registrations\"], \"cropByRecordState\": [\"record_state\", \"registrations\"]};",
          "pm.test('status is 200', () => pm.response.to.have.status(200));",
          "const path = pm.request.url.getPath();",
          "if (path === '/health') {",
          "  pm.test('health reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
          "} else {",
          "  const chart = path.split('/').pop();",
          "  const rows = pm.response.json();",
          "  pm.test('body is an array', () => pm.expect(rows).to.be.an('array'));",
          "  const keys = CONTRACT[chart];",
          "  if (keys) {",
          "    pm.test('rows have exactly the contract keys', () => rows.forEach(r => pm.expect(Object.keys(r).sort()).to.eql(keys)));",
          "  }",
          "}"
        ]
      }
    }
  ],
